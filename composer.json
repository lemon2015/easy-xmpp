{
    "name": "mark-fish/easy-xmpp",
    "description": "PHP library for XMPP",
    "keywords": [
        "easyxmpp",
        "easy-xmpp",
        "xmpp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mark.Wang",
            "email": "332778006@qq.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-xml": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "ext-curl": "Required for BOSH connections",
        "ext-dom": "Required for BOSH connections",
        "ext-simplexml": "Required for BOSH connections"
    },
    "autoload": {
        "psr-4": {
            "EasyXmpp\\": "src/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "e2e": "php tests/E2E.php",
        "muc": "php tests/MucE2E.php",
        "pubsub": "php tests/PubSubE2E.php"
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-rdkp-vv9z-mjkg"
            ]
        }
    }
}
